---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout
  title={`Contact · ${siteConfig.name}`}
  description={`Get in touch with ${siteConfig.name}, Project Manager at Innovate Solution. Discuss upcoming product launches, project management consulting, or delivery alignment.`}
>
  <div class="mx-auto max-w-[1120px] px-6 py-16 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Headline, Bio & Direct Contacts (5 cols) -->
      <div class="lg:col-span-5 flex flex-col items-start">
        <span class="label-caps mb-4">
          <span class="pulsing-dot" aria-hidden="true"></span>
          Start A Conversation
        </span>
        <h1 class="page-h1 text-[#F4F4F5] mb-6">
          Let's talk.
        </h1>
        <p class="body-lead text-base text-[#A1A1AA] mb-10">
          Whether you are planning a high-stakes software launch, scaling complex cloud APIs, or seeking disciplined technical project management leadership—I'm ready to help you deliver calmly and on time.
        </p>

        <!-- Direct Contact Details -->
        <div class="flex flex-col gap-6 w-full pt-8 border-t border-[#26262F]">
          <!-- Email Card -->
          <a
            href={`mailto:${siteConfig.email}`}
            class="group flex items-center gap-4 rounded-2xl border border-[#26262F] bg-[#13131A] p-4 transition-all hover:border-[#C6F432] hover:shadow-[0_0_20px_rgba(198,244,50,0.15)]"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#1C1C26] text-[#C6F432] group-hover:bg-[#C6F432] group-hover:text-[#0A0A0F] transition-colors">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-xs text-[#A1A1AA] uppercase tracking-wider font-semibold">Direct Email</span>
              <span class="text-sm font-bold text-[#F4F4F5] group-hover:text-[#C6F432] transition-colors">
                {siteConfig.email}
              </span>
            </div>
          </a>

          <!-- LinkedIn Card -->
          <a
            href={siteConfig.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-2xl border border-[#26262F] bg-[#13131A] p-4 transition-all hover:border-[#C6F432] hover:shadow-[0_0_20px_rgba(198,244,50,0.15)]"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#1C1C26] text-[#C6F432] group-hover:bg-[#C6F432] group-hover:text-[#0A0A0F] transition-colors">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-xs text-[#A1A1AA] uppercase tracking-wider font-semibold">Professional Profile</span>
              <span class="text-sm font-bold text-[#F4F4F5] group-hover:text-[#C6F432] transition-colors">
                Connect on LinkedIn
              </span>
            </div>
          </a>

          <!-- Location Info -->
          <div class="flex items-center gap-3 px-2 text-xs text-[#A1A1AA]">
            <svg class="h-4 w-4 text-[#C6F432]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Based in {siteConfig.location} · Working with global teams across all time zones</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form Card (7 cols) -->
      <div class="lg:col-span-7">
        <div class="rounded-[28px] border border-[#26262F] bg-[#13131A] p-8 md:p-10 shadow-2xl relative overflow-hidden">
          <h2 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mb-2">
            Send a message
          </h2>
          <p class="text-sm text-[#A1A1AA] mb-8">
            Fill out the form below and I'll respond within 24 hours.
          </p>

          <form
            id="contact-form"
            action={siteConfig.formEndpoint}
            method="POST"
            class="flex flex-col gap-6"
          >
            <!-- Honeypot anti-spam field -->
            <div class="hidden" aria-hidden="true">
              <label for="_gotcha">Do not fill this field if you are human</label>
              <input type="text" name="_gotcha" id="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Name Field -->
            <div class="flex flex-col gap-2">
              <label for="contact-name" class="text-xs font-semibold uppercase tracking-wider text-[#F4F4F5]">
                Your Name <span class="text-[#C6F432]">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full rounded-xl border border-[#26262F] bg-[#1C1C26] px-4 py-3.5 text-sm text-[#F4F4F5] placeholder-[#A1A1AA]/50 transition-colors focus:border-[#C6F432] focus:outline-none"
              />
            </div>

            <!-- Email Field -->
            <div class="flex flex-col gap-2">
              <label for="contact-email" class="text-xs font-semibold uppercase tracking-wider text-[#F4F4F5]">
                Email Address <span class="text-[#C6F432]">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="jane@company.com"
                class="w-full rounded-xl border border-[#26262F] bg-[#1C1C26] px-4 py-3.5 text-sm text-[#F4F4F5] placeholder-[#A1A1AA]/50 transition-colors focus:border-[#C6F432] focus:outline-none"
              />
            </div>

            <!-- Message Field -->
            <div class="flex flex-col gap-2">
              <label for="contact-message" class="text-xs font-semibold uppercase tracking-wider text-[#F4F4F5]">
                Project or Inquiry Details <span class="text-[#C6F432]">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="5"
                placeholder="Tell me about your product, roadmap goals, or team requirements..."
                class="w-full rounded-xl border border-[#26262F] bg-[#1C1C26] px-4 py-3.5 text-sm text-[#F4F4F5] placeholder-[#A1A1AA]/50 transition-colors focus:border-[#C6F432] focus:outline-none resize-y"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              id="submit-btn"
              type="submit"
              class="hover-btn group mt-2 flex min-h-[50px] w-full items-center justify-center gap-2 rounded-full bg-[#C6F432] px-8 py-3.5 text-sm font-bold text-[#0A0A0F] shadow-[0_0_24px_rgba(198,244,50,0.25)] transition-all cursor-pointer"
            >
              <span id="btn-text">Send Message</span>
              <svg
                id="btn-icon"
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Status Banner (Success / Error) -->
            <div
              id="form-status"
              class="hidden rounded-xl p-4 text-xs font-semibold"
              role="alert"
            ></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const formStatus = document.getElementById('form-status');
    const honeypot = document.getElementById('_gotcha') as HTMLInputElement | null;

    if (!form || !submitBtn || !btnText || !formStatus) return;

    form.addEventListener('submit', async (e) => {
      // Spam check
      if (honeypot && honeypot.value.trim() !== '') {
        e.preventDefault();
        return;
      }

      // Check if endpoint is placeholder
      const action = form.getAttribute('action') || '';
      if (action.includes('placeholder')) {
        e.preventDefault();
        // Client-side demo fallback
        submitBtn.disabled = true;
        btnText.textContent = 'Sending...';

        setTimeout(() => {
          submitBtn.disabled = false;
          btnText.textContent = 'Send Message';
          formStatus.className = 'block rounded-xl border border-[#C6F432]/40 bg-[#C6F432]/10 p-4 text-xs font-semibold text-[#C6F432]';
          formStatus.textContent = 'Thank you! Your message has been prepared. (Configure real Formspree endpoint in src/config/site.ts).';
          form.reset();
        }, 600);
        return;
      }

      // If real endpoint, use fetch for smooth asynchronous submission
      e.preventDefault();
      submitBtn.disabled = true;
      btnText.textContent = 'Sending...';

      try {
        const formData = new FormData(form);
        const response = await fetch(action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (response.ok) {
          formStatus.className = 'block rounded-xl border border-[#C6F432]/40 bg-[#C6F432]/10 p-4 text-xs font-semibold text-[#C6F432]';
          formStatus.textContent = 'Thank you! Your message has been sent successfully. I will get back to you shortly.';
          form.reset();
        } else {
          throw new Error('Submission failed');
        }
      } catch (err) {
        formStatus.className = 'block rounded-xl border border-red-500/40 bg-red-500/10 p-4 text-xs font-semibold text-red-400';
        formStatus.textContent = 'Unable to send message right now. Please email directly at contact@akhirulislam.com.';
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Send Message';
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
