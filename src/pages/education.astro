---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const educationList = [
  {
    degree: "B.Sc. in Computer Science & Engineering (CSE)",
    institution: "Varendra University",
    location: "Rajshahi, Bangladesh",
    group: "Computer Science & Engineering",
    type: "Undergraduate Degree",
    status: "Completed",
    isPrimary: true,
    description:
      "A rigorous four-year engineering curriculum focused on computer science fundamentals, data structures, algorithms, object-oriented software engineering, database systems, and distributed system architectures. This formal engineering background provides the technical depth to lead engineering teams, understand code-level blockers, and design scalable software lifecycles.",
    highlights: [
      "Software Engineering & Architecture",
      "Object-Oriented Programming & Design Patterns",
      "Database Management Systems & SQL",
      "Data Structures & Algorithm Optimization",
      "Web Technologies & RESTful APIs",
      "Agile Project Management Methodologies",
    ],
  },
  {
    degree: "Higher Secondary Certificate (HSC)",
    institution: "Shah Mokhdum College",
    location: "Rajshahi, Bangladesh",
    group: "Science",
    type: "Higher Secondary",
    status: "Completed",
    isPrimary: false,
    description:
      "Comprehensive science education with advanced coursework in Higher Mathematics, Physics, Chemistry, and Information Technology—solidifying core quantitative analysis and analytical problem-solving skills.",
    highlights: ["Higher Mathematics", "Physics", "Chemistry", "Information Technology"],
  },
  {
    degree: "Secondary School Certificate (SSC)",
    institution: "Nazipur Govt. High School",
    location: "Naogaon, Bangladesh",
    group: "Science",
    type: "Secondary School",
    status: "Completed",
    isPrimary: false,
    description:
      "Foundational science curriculum with strong emphasis on general science, mathematics, and disciplined analytical thinking.",
    highlights: ["General Science", "Mathematics", "Analytical Problem Solving"],
  },
];
---

<BaseLayout
  title={`Education · ${siteConfig.name}`}
  description={`Academic background and engineering education of ${siteConfig.name}, B.Sc. in Computer Science & Engineering from Varendra University, Rajshahi.`}
>
  <div class="mx-auto max-w-[1280px] px-6 py-16 md:py-24">
    <!-- Header / Headline -->
    <div class="max-w-3xl mb-16 md:mb-20">
      <span class="label-caps mb-4">
        <span class="pulsing-dot" aria-hidden="true"></span>
        Academic Credentials & Foundations
      </span>
      <h1 class="page-h1 text-[#F4F4F5]">
        Engineering roots. <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38BDF8] via-sky-200 to-[#818CF8]">Academic rigor.</span>
      </h1>
      <p class="body-lead mt-6 text-[#A1A1AA]">
        My transition into high-velocity Technical Project Management is rooted in formal Computer Science and Engineering training. Having written code and understood systems at the architectural level, I bridge the gap between business objectives and engineering realities.
      </p>
    </div>

    <!-- Education Timeline & Cards -->
    <div class="flex flex-col gap-10 mb-20 md:mb-28">
      {
        educationList.map((edu) => (
          <div
            class:list={[
              "hover-card group relative overflow-hidden rounded-[28px] border transition-all duration-300",
              edu.isPrimary
                ? "border-[#38BDF8]/40 bg-gradient-to-b from-[#131B2A] via-[#10141E] to-[#0D1017] p-8 md:p-12 shadow-[0_0_35px_rgba(56,189,248,0.12)] hover:border-[#38BDF8] hover:shadow-[0_0_45px_rgba(56,189,248,0.22)]"
                : "border-[#26262F] bg-[#13131A] p-8 md:p-10 hover:border-[#3A3A46] hover:bg-[#151520]"
            ]}
          >
            {/* Top Glowing Gradient Accent on Primary Card */}
            {edu.isPrimary && (
              <div class="pointer-events-none absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#38BDF8] to-transparent" />
            )}

            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8">
              {/* Left Column: Degree, School, Location & Description */}
              <div class="flex-1 max-w-3xl">
                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span
                    class:list={[
                      "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider",
                      edu.isPrimary
                        ? "border border-[#38BDF8]/40 bg-[#38BDF8]/15 text-[#38BDF8] shadow-[0_0_12px_rgba(56,189,248,0.2)]"
                        : "border border-[#26262F] bg-[#1C1C26] text-[#A1A1AA]"
                    ]}
                  >
                    {edu.isPrimary && <span class="h-1.5 w-1.5 rounded-full bg-[#38BDF8] animate-pulse" />}
                    {edu.type}
                  </span>

                  <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400">
                    ✓ {edu.status}
                  </span>

                  <span class="rounded-full border border-[#26262F] bg-[#13131A] px-3 py-1 text-xs font-medium text-[#A1A1AA]">
                    {edu.group}
                  </span>
                </div>

                <!-- Degree Title -->
                <h2
                  class:list={[
                    "font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold tracking-tight mb-2",
                    edu.isPrimary ? "text-[#F4F4F5] group-hover:text-[#38BDF8] transition-colors" : "text-[#F4F4F5]"
                  ]}
                >
                  {edu.degree}
                </h2>

                <!-- Institution & Location -->
                <div class="flex flex-wrap items-center gap-4 text-sm font-semibold text-[#38BDF8] mb-6">
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 shrink-0 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <span class="text-base text-[#F4F4F5]">{edu.institution}</span>
                  </div>

                  <span class="text-[#26262F] hidden sm:inline">•</span>

                  <div class="flex items-center gap-1.5 text-xs text-[#A1A1AA] font-normal">
                    <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>{edu.location}</span>
                  </div>
                </div>

                <!-- Narrative Description -->
                <p class="text-sm md:text-base leading-relaxed text-[#A1A1AA] mb-6">
                  {edu.description}
                </p>

                <!-- Coursework / Focus Chips -->
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-[#A1A1AA] block mb-3">
                    Key Academic Disciplines & Focus:
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {edu.highlights.map((h) => (
                      <span class="inline-flex items-center rounded-lg border border-[#26262F] bg-[#1C1C26]/80 px-3 py-1.5 text-xs font-medium text-[#E4E4E7] transition-colors hover:border-[#38BDF8]/60 hover:text-[#38BDF8]">
                        {h}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              {/* Right Column: Visual Academic Badge / Icon */}
              <div class="shrink-0 flex lg:flex-col items-center justify-between border-t lg:border-t-0 lg:border-l border-[#26262F] pt-6 lg:pt-0 lg:pl-8">
                <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-[#38BDF8]/30 bg-[#38BDF8]/10 text-[#38BDF8] shadow-[0_0_20px_rgba(56,189,248,0.2)]">
                  <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5" />
                  </svg>
                </div>

                <div class="mt-4 text-center hidden lg:block">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-[#A1A1AA]">
                    Discipline
                  </span>
                  <p class="font-['Space_Grotesk'] text-sm font-bold text-[#F4F4F5] mt-0.5">
                    {edu.group}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Why CSE Matters In Project Management Box -->
    <div class="rounded-[28px] border border-[#38BDF8]/30 bg-gradient-to-r from-[#131B2A]/90 via-[#10141E]/95 to-[#131B2A]/90 p-8 md:p-12 shadow-2xl backdrop-blur-xl mb-16">
      <div class="flex flex-col md:flex-row items-start justify-between gap-8">
        <div class="max-w-2xl">
          <span class="label-caps mb-3">
            <span class="pulsing-dot" aria-hidden="true"></span>
            The Engineering Advantage
          </span>
          <h2 class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold text-[#F4F4F5] mb-4">
            Why a CSE degree makes a better Project Manager.
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-[#A1A1AA]">
            Non-technical project management often relies on guesswork for estimating software complexity. With a formal Computer Science & Engineering degree, I review architecture schemas, identify database bottlenecks, comprehend API constraints, and earn the trust of software developers by speaking their native language.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 shrink-0 w-full md:w-auto">
          <!-- View CV in new tab -->
          <a
            href={siteConfig.cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover-btn group inline-flex min-h-[46px] items-center justify-center gap-2 rounded-full border border-[#38BDF8] bg-[#38BDF8] px-6 py-2.5 text-xs font-bold text-[#0A0A0F] shadow-[0_0_20px_rgba(56,189,248,0.3)] transition-all hover:bg-white"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>View Full Resume</span>
          </a>

          <!-- Work link -->
          <a
            href="/projects"
            class="hover-btn inline-flex min-h-[46px] items-center justify-center rounded-full border border-[#3A3A46] bg-[#13131A] px-6 py-2.5 text-xs font-semibold text-[#F4F4F5] transition-all hover:border-[#38BDF8]"
          >
            Explore Case Studies
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
