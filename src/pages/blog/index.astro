---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";

const posts = await getCollection("posts");
---

<BaseLayout
  title={`Blog & Thoughts · ${siteConfig.name}`}
  description="Insights on technical project management, software architecture delivery, sprint velocity, and calm production launches."
>
  <div class="mx-auto max-w-[1120px] px-6 py-16 md:py-24">
    <!-- Header -->
    <div class="max-w-3xl mb-14">
      <span class="label-caps mb-4">
        <span class="pulsing-dot" aria-hidden="true"></span>
        Writings & Field Notes
      </span>
      <h1 class="page-h1 text-[#F4F4F5]">
        Thoughts on shipping.
      </h1>
      <p class="body-lead mt-6 text-[#A1A1AA]">
        Practical reflections on technical software project management, navigating API complexity, and building calm, high-velocity engineering cultures.
      </p>
    </div>

    <!-- Active Posts Listing -->
    {
      posts.length > 0 && (
        <div class="flex flex-col divide-y divide-[#26262F] border-y border-[#26262F]">
          {posts.map((post) => (
            <article class="py-8 transition-colors hover:bg-[#13131A]/40 px-4 rounded-xl">
              <a href={`/blog/${post.id}`} class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                  <span class="text-xs text-[#C6F432] font-semibold">
                    {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                  <h2 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mt-1 hover:text-[#C6F432] transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-sm text-[#A1A1AA] mt-2">
                    {post.data.description}
                  </p>
                </div>
                <div class="flex items-center gap-1 text-sm font-semibold text-[#C6F432]">
                  <span>Read article</span>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </a>
            </article>
          ))}
        </div>
      )
    }

    <!-- Themed Empty State -->
    {
      posts.length === 0 && (
        <div class="rounded-[28px] border border-[#26262F] bg-[#13131A] p-12 md:p-16 text-center max-w-2xl mx-auto">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#1C1C26] text-[#C6F432] border border-[#26262F] mb-6">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <h2 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mb-3">
            Articles in preparation
          </h2>
          <p class="text-sm leading-relaxed text-[#A1A1AA] max-w-md mx-auto mb-8">
            I am currently compiling essays and tactical guides on modern software architecture, sprint risk governance, and calm launch runbooks. Check back soon.
          </p>
          <a
            href="/projects"
            class="hover-btn inline-flex items-center gap-2 rounded-full bg-[#C6F432] px-6 py-3 text-sm font-bold text-[#0A0A0F]"
          >
            <span>Explore Case Studies</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>
