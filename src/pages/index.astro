---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout title={`${siteConfig.name} · ${siteConfig.title}`}>
  <div class="mx-auto max-w-[1120px] px-6 py-20">
    <div class="rounded-3xl border border-[#26262F] bg-[#13131A] p-12 text-center">
      <span class="label-caps mb-4">
        <span class="pulsing-dot"></span>
        {siteConfig.title} · {siteConfig.company}
      </span>
      <h1 class="hero-h1 mb-6 text-[#F4F4F5]">
        {siteConfig.headline}
      </h1>
      <p class="body-lead mx-auto text-[#A1A1AA]">
        {siteConfig.introLine}
      </p>
    </div>
  </div>
</BaseLayout>
