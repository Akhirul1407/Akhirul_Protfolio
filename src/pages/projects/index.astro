---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";

const allProjects = (await getCollection("projects")).sort((a, b) =>
  a.data.number.localeCompare(b.data.number)
);

const categories = ["All", "Delivery", "Client onboarding", "Team leadership"] as const;
---

<BaseLayout
  title={`Projects · ${siteConfig.name}`}
  description="Explore outcome-driven case studies in technical software delivery, API integrations, and high-velocity engineering alignment."
>
  <div class="mx-auto max-w-[1120px] px-6 py-16 md:py-24">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <span class="label-caps mb-4">
        <span class="pulsing-dot" aria-hidden="true"></span>
        Proven Delivery Record
      </span>
      <h1 class="page-h1 text-[#F4F4F5]">
        Projects I'm proud of.
      </h1>
      <p class="body-lead mt-6 text-[#A1A1AA]">
        A curated selection of mission-critical software initiatives. In accordance with client agreements, all projects are identified by outcome headline with confidential client descriptors.
      </p>
    </div>

    <!-- Category Filter Chips -->
    <div class="mb-12 flex flex-wrap items-center gap-2.5" role="tablist" aria-label="Project categories">
      {
        categories.map((cat, index) => (
          <button
            type="button"
            data-filter={cat}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            class:list={[
              "project-filter-btn rounded-full px-5 py-2.5 text-xs font-semibold tracking-wide transition-all duration-200 cursor-pointer",
              index === 0
                ? "active bg-[#C6F432] text-[#0A0A0F] shadow-[0_0_16px_rgba(198,244,50,0.3)]"
                : "border border-[#26262F] bg-[#13131A] text-[#A1A1AA] hover:border-[#3A3A46] hover:text-[#F4F4F5]"
            ]}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Large Editorial List -->
    <div id="projects-list" class="flex flex-col divide-y divide-[#26262F] border-y border-[#26262F]">
      {
        allProjects.map((project) => (
          <article
            class="project-item group relative transition-colors duration-200 hover:bg-[#13131A]/60"
            data-category={project.data.category}
          >
            <a
              href={`/projects/${project.id}`}
              class="flex flex-col md:flex-row md:items-center justify-between gap-6 py-10 px-4 md:px-6 rounded-2xl"
              aria-label={`View case study: ${project.data.outcomeHeadline}`}
            >
              <!-- Left: Number & Details -->
              <div class="flex items-start gap-6 md:gap-8 max-w-3xl">
                <!-- Large Space Grotesk Number -->
                <span class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-[#C6F432] shrink-0 mt-0.5">
                  {project.data.number}
                </span>

                <div class="flex flex-col items-start">
                  <!-- Category & Confidential Tags -->
                  <div class="flex flex-wrap items-center gap-2.5 mb-2.5 text-xs">
                    <span class="rounded-full border border-[#26262F] bg-[#1C1C26] px-2.5 py-0.5 font-medium text-[#C6F432]">
                      {project.data.category}
                    </span>
                    <span class="text-[#3A3A46]">·</span>
                    <span class="text-[#A1A1AA]">
                      {project.data.clientGeneric}
                    </span>
                  </div>

                  <!-- Outcome Headline -->
                  <h2 class="font-['Space_Grotesk'] text-xl sm:text-2xl font-bold text-[#F4F4F5] transition-colors group-hover:text-[#C6F432]">
                    {project.data.outcomeHeadline}
                  </h2>

                  <!-- One-Line Description -->
                  <p class="mt-2 text-sm leading-relaxed text-[#A1A1AA]">
                    {project.data.oneLiner}
                  </p>
                </div>
              </div>

              <!-- Right: Arrow (moves diagonally on hover) -->
              <div class="flex items-center gap-4 self-end md:self-center shrink-0">
                <span class="hidden lg:inline-block text-xs font-semibold text-[#A1A1AA] uppercase tracking-wider group-hover:text-[#C6F432]">
                  Case study
                </span>
                <div class="flex h-12 w-12 items-center justify-center rounded-full border border-[#26262F] bg-[#13131A] text-[#F4F4F5] transition-all duration-200 group-hover:border-[#C6F432] group-hover:bg-[#C6F432] group-hover:text-[#0A0A0F] group-hover:shadow-[0_0_18px_rgba(198,244,50,0.3)]">
                  <svg
                    class="h-5 w-5 transition-transform duration-200 group-hover:-translate-y-1 group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    <!-- Empty Filter Fallback -->
    <div id="no-projects-msg" class="hidden py-16 text-center text-[#A1A1AA]">
      No projects found under this category.
    </div>
  </div>
</BaseLayout>

<script>
  function initProjectFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.project-filter-btn');
    const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
    const noProjectsMsg = document.getElementById('no-projects-msg');

    if (!filterButtons.length || !projectItems.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'All';

        // Update active tab styles
        filterButtons.forEach((b) => {
          const isSelected = b === btn;
          b.setAttribute('aria-selected', String(isSelected));
          if (isSelected) {
            b.classList.remove('border', 'border-[#26262F]', 'bg-[#13131A]', 'text-[#A1A1AA]');
            b.classList.add('bg-[#C6F432]', 'text-[#0A0A0F]', 'shadow-[0_0_16px_rgba(198,244,50,0.3)]');
          } else {
            b.classList.remove('bg-[#C6F432]', 'text-[#0A0A0F]', 'shadow-[0_0_16px_rgba(198,244,50,0.3)]');
            b.classList.add('border', 'border-[#26262F]', 'bg-[#13131A]', 'text-[#A1A1AA]');
          }
        });

        // Filter items
        let visibleCount = 0;
        projectItems.forEach((item) => {
          const category = item.getAttribute('data-category');
          if (filter === 'All' || category === filter) {
            item.style.display = 'block';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noProjectsMsg) {
          noProjectsMsg.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  }

  initProjectFilters();
  document.addEventListener('astro:page-load', initProjectFilters);
</script>
