---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const testimonials = await getCollection("testimonials");

const principles = [
  {
    number: "01",
    title: "Over-communicate early to prevent midnight fire-drills",
    description:
      "Surprises belong in birthday parties, not software releases. I surface risks, dependency blockers, and schedule slips the instant they appear—when they are still cheap and simple to resolve.",
  },
  {
    number: "02",
    title: "Protect developer flow by filtering ambiguous scope",
    description:
      "Engineers write the best software when requirements are concrete and uninterrupted. I act as a shock absorber between shifting stakeholder demands and the sprint backlog.",
  },
  {
    number: "03",
    title: "Align every ticket to commercial delivery",
    description:
      "Velocity without purpose is just wasted effort. Every user story, technical refactor, and QA gate must clearly support the client's business goal and product launch timeline.",
  },
];

const skills = [
  "Technical Project Management",
  "API & Systems Architecture",
  "Agile & Scrum Delivery",
  "Release Governance & CI/CD",
  "Stakeholder Communication",
  "Sprint Velocity Optimization",
  "Cross-Functional Squad Leadership",
  "Risk & Dependency Management",
  "UAT & Production Readiness",
  "Technical Incident Post-Mortems",
];

const certifications = [
  "B.Sc. in Computer Science & Engineering (CSE)",
  "[ADD: Certified ScrumMaster (CSM) or Professional Scrum Master (PSM)]",
  "[ADD: PMP or Technical Cloud Certification, e.g. AWS/Azure]",
];
---

<BaseLayout
  title={`About · ${siteConfig.name}`}
  description={`Learn about ${siteConfig.name}, Project Manager at Innovate Solution. Discover my principles, experience, and approach to software delivery.`}
>
  <div class="mx-auto max-w-[1280px] px-6 py-16 md:py-24">
    <!-- Header / Headline -->
    <div class="max-w-3xl mb-16 md:mb-24">
      <span class="label-caps mb-4">
        <span class="pulsing-dot" aria-hidden="true"></span>
        The Person Behind The Plan
      </span>
      <h1 class="page-h1 text-[#F4F4F5]">
        The person behind the plan.
      </h1>
      <p class="body-lead mt-6 text-[#A1A1AA]">
        I'm Akhirul. At Innovate Solution I keep clients, developers and deadlines pointed in the same direction, so software launches land on time and calm.
      </p>
    </div>

    <!-- Portrait & Story Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start mb-24 md:mb-32">
      <!-- Portrait Graphic Card (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative overflow-hidden rounded-[28px] border border-[#26262F] bg-[#13131A] p-8 text-center shadow-xl">
          <!-- Background Glow -->
          <div class="absolute -right-10 -top-10 h-48 w-48 rounded-full bg-[#38BDF8]/10 blur-3xl" aria-hidden="true"></div>

          <!-- Real Portrait Photo -->
          <div class="relative mx-auto aspect-[4/5] w-full max-w-[340px] overflow-hidden rounded-2xl border border-[#3A3A46] bg-[#0E0E14] shadow-2xl group">
            <img
              src={siteConfig.avatar}
              alt={siteConfig.name}
              width="680"
              height="850"
              class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#13131A] via-transparent to-transparent opacity-40"></div>
          </div>

          <div class="mt-6">
            <h2 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5]">
              {siteConfig.name}
            </h2>
            <p class="text-sm font-medium text-[#38BDF8] mt-1">
              {siteConfig.title}
            </p>
            <p class="text-xs text-[#A1A1AA] mt-0.5">
              {siteConfig.company} · {siteConfig.location}
            </p>
          </div>

          <div class="mt-6 pt-6 border-t border-[#26262F] flex flex-wrap justify-center gap-2">
            <span class="rounded-full bg-[#1C1C26] px-3 py-1 text-xs text-[#F4F4F5] border border-[#26262F]">
              B.Sc. in CSE
            </span>
            <span class="rounded-full bg-[#1C1C26] px-3 py-1 text-xs text-[#F4F4F5] border border-[#26262F]">
              Technical PM
            </span>
            <span class="rounded-full bg-[#1C1C26] px-3 py-1 text-xs text-[#F4F4F5] border border-[#26262F]">
              Calm Delivery
            </span>
          </div>
        </div>
      </div>

      <!-- Narrative Story (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-6 text-[#A1A1AA] text-base leading-relaxed">
        <h2 class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-[#F4F4F5]">
          Bridging technical depth with business delivery.
        </h2>

        <p>
          Throughout my career in software project management, I've seen that the most expensive failures rarely stem from pure coding challenges. They happen when business stakeholders expect one thing, designers wireframe another, and developers build what made sense on day three without a unified technical roadmap.
        </p>

        <p>
          With a strong academic and practical foundation in <strong class="text-[#F4F4F5]">Computer Science & Engineering (CSE)</strong>, I understand what happens under the hood. At <strong class="text-[#F4F4F5]">Innovate Solution</strong>, I lead technical project delivery where architectural reliability is paramount: high-volume API integrations, distributed microservices, and continuous deployment workflows.
        </p>

        <p>
          Because I speak the technical language of developers and the outcome-focused language of executive stakeholders, I create certainty. I translate ambiguous goals into well-scoped technical user stories, shield engineering squads from scope churn, and structure deployment runbooks that turn stressful releases into quiet, predictable successes.
        </p>

        <div class="mt-4 flex items-center gap-4">
          <a
            href="/contact"
            class="hover-btn inline-flex items-center gap-2 rounded-full bg-[#38BDF8] px-6 py-3 text-sm font-bold text-[#0A0A0F]"
          >
            <span>Let's talk about your project</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- "How I Work" - 3 Numbered Principle Cards -->
    <div class="mb-24 md:mb-32">
      <div class="mb-12">
        <span class="label-caps mb-3">
          <span class="pulsing-dot" aria-hidden="true"></span>
          Delivery Philosophy
        </span>
        <h2 class="section-h2 text-[#F4F4F5]">
          How I work
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          principles.map((principle) => (
            <div class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-8">
              <div>
                <span class="font-['Space_Grotesk'] text-3xl font-bold text-[#38BDF8]">
                  {principle.number}
                </span>
                <h3 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5] mt-4 mb-3">
                  {principle.title}
                </h3>
              </div>
              <p class="text-sm leading-relaxed text-[#A1A1AA] mt-2">
                {principle.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Experience Overview Banner (Full details moved to dedicated /experience) -->
    <div class="mb-24 rounded-[28px] border border-[#26262F] bg-gradient-to-r from-[#131B2A]/90 via-[#10141E]/95 to-[#131B2A]/90 p-8 md:p-10 shadow-xl transition-all hover:border-[#38BDF8]/40">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <span class="label-caps mb-2">
            <span class="pulsing-dot" aria-hidden="true"></span>
            Career Track Record
          </span>
          <h2 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5]">
            Project Manager at Innovate Solution
          </h2>
          <p class="text-sm text-[#A1A1AA] mt-1 max-w-xl">
            Directing software delivery, API distribution architectures, and agile engineering squads across enterprise client engagements.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href="/experience"
            class="inline-flex items-center gap-2 rounded-full border border-[#38BDF8] bg-[#38BDF8]/10 px-5 py-2.5 text-xs font-bold text-[#38BDF8] transition-all hover:bg-[#38BDF8] hover:text-[#0A0A0F] hover:shadow-[0_0_20px_rgba(56,189,248,0.3)] hover:scale-105"
          >
            <span>View Full Experience</span>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Skills and Certifications Chips -->
    <div class="mb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Skills (7 cols) -->
        <div class="lg:col-span-7 rounded-[28px] border border-[#26262F] bg-[#13131A] p-8">
          <span class="label-caps mb-3">Core Competencies</span>
          <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mb-6">
            Delivery & PM Skills
          </h3>
          <div class="flex flex-wrap gap-2.5">
            {
              skills.map((skill) => (
                <span class="inline-flex items-center rounded-xl border border-[#26262F] bg-[#1C1C26] px-4 py-2 text-xs font-semibold text-[#F4F4F5] transition-colors hover:border-[#38BDF8] hover:text-[#38BDF8]">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Certifications (5 cols) -->
        <div class="lg:col-span-5 rounded-[28px] border border-[#26262F] bg-[#13131A] p-8 flex flex-col justify-between">
          <div>
            <span class="label-caps mb-3">Qualifications</span>
            <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mb-6">
              Certifications
            </h3>
            <div class="flex flex-col gap-3">
              {
                certifications.map((cert) => (
                  <div class="flex items-center gap-3 rounded-xl border border-[#26262F] bg-[#1C1C26]/70 p-3.5 text-xs text-[#F4F4F5]">
                    <svg class="h-4 w-4 shrink-0 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                    <span>{cert}</span>
                  </div>
                ))
              }
            </div>
          </div>
          <p class="text-[11px] text-[#A1A1AA] mt-4">
            * Recorded in PLACEHOLDERS.md for real credential verification.
          </p>
        </div>
      </div>
    </div>

    <!-- Academic Background Link Banner -->
    <div class="mb-24 rounded-[28px] border border-[#26262F] bg-[#13131A] p-8 md:p-10 transition-all hover:border-[#38BDF8]/40 shadow-lg">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#38BDF8]/30 bg-[#38BDF8]/10 text-[#38BDF8] shadow-[0_0_15px_rgba(56,189,248,0.2)]">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5" />
            </svg>
          </div>
          <div>
            <span class="label-caps mb-1">Academic Foundation</span>
            <h3 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5]">
              B.Sc. in Computer Science & Engineering
            </h3>
            <p class="text-xs text-[#A1A1AA] mt-0.5">
              Varendra University, Rajshahi · Shah Mokhdum College · Nazipur Govt. High School
            </p>
          </div>
        </div>
        <a
          href="/education"
          class="inline-flex items-center gap-2 rounded-full border border-[#38BDF8] bg-[#38BDF8]/10 px-5 py-2.5 text-xs font-bold text-[#38BDF8] transition-all hover:bg-[#38BDF8] hover:text-[#0A0A0F] hover:shadow-[0_0_20px_rgba(56,189,248,0.3)] shrink-0"
        >
          <span>View Full Academic Profile</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Testimonials Section -->
    {
      testimonials.length > 0 && (
        <div class="mb-12">
          <div class="mb-12">
            <span class="label-caps mb-3">
              <span class="pulsing-dot" aria-hidden="true"></span>
              Colleague & Client Endorsements
            </span>
            <h2 class="section-h2 text-[#F4F4F5]">
              What peers say
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {testimonials.map((t) => (
              <div class="hover-card flex flex-col justify-between rounded-[28px] border border-[#26262F] bg-[#13131A] p-8">
                <blockquote class="text-base italic leading-relaxed text-[#F4F4F5]/90 mb-6">
                  "{t.data.quote}"
                </blockquote>
                <div class="pt-4 border-t border-[#26262F] flex items-center justify-between">
                  <span class="text-xs font-semibold text-[#38BDF8]">
                    {t.data.authorGeneric}
                  </span>
                  <span class="text-xs text-[#A1A1AA]">
                    {t.data.region}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
