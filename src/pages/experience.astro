---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const experienceList = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order
);

const deliveryMetrics = [
  { value: "98%", label: "On-Time Milestone Delivery", desc: "Maintained across enterprise client releases" },
  { value: "-40%", label: "Post-Deploy Hotfixes", desc: "Achieved via standardized QA & deployment gates" },
  { value: "100%", label: "Agile Sprint Alignment", desc: "Predictable velocity without midnight fire-drills" },
  { value: "Multi-Cloud", label: "Distributed Architecture", desc: "Complex B2B & microservices integration" },
];

const pmToolstack = [
  "Jira & Confluence",
  "Linear & Notion",
  "Agile & Scrum Frameworks",
  "Sprint Burndown Analysis",
  "Risk Mitigation Matrices",
  "API Spec & Postman",
  "Cross-Squad Synchronization",
  "Stakeholder Alignment",
  "CI/CD & Deployment Gates",
  "Capacity & Velocity Planning",
];
---

<BaseLayout
  title={`Experience · ${siteConfig.name}`}
  description={`Professional career track record and project management experience of ${siteConfig.name}, Project Manager at Innovate Solution.`}
>
  <div class="mx-auto max-w-[1280px] px-6 py-16 md:py-24">
    <!-- Header / Headline with CV Action -->
    <div class="mb-16 md:mb-20 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
      <div class="max-w-3xl">
        <span class="label-caps mb-4">
          <span class="pulsing-dot" aria-hidden="true"></span>
          Career Track Record & Leadership
        </span>
        <h1 class="page-h1 text-[#F4F4F5]">
          Professional <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38BDF8] via-sky-200 to-[#818CF8]">Experience.</span>
        </h1>
        <p class="body-lead mt-6 text-[#A1A1AA]">
          Leading software delivery and engineering squads at Innovate Solution. I specialize in keeping distributed cloud architectures, complex client requirements, and engineering sprints pointed in the exact same direction.
        </p>
      </div>

      <!-- CV Download / Preview Action -->
      <a
        href={siteConfig.cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover-btn group inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-full border border-[#38BDF8] bg-[#38BDF8]/10 px-6 py-3 text-sm font-bold text-[#38BDF8] backdrop-blur-md transition-all hover:bg-[#38BDF8] hover:text-[#0A0A0F] hover:shadow-[0_0_24px_rgba(56,189,248,0.35)] hover:scale-105 shrink-0"
        aria-label="View and Download CV (Opens PDF in new tab)"
      >
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Executive CV</span>
      </a>
    </div>

    <!-- Key Delivery Metrics Ribbon -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-20">
      {
        deliveryMetrics.map((m) => (
          <div class="rounded-2xl border border-[#26262F] bg-[#13131A]/80 p-6 backdrop-blur-md transition-all hover:border-[#38BDF8]/50 hover:shadow-[0_0_20px_rgba(56,189,248,0.15)]">
            <span class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-extrabold text-[#38BDF8]">
              {m.value}
            </span>
            <h2 class="font-['Space_Grotesk'] text-sm sm:text-base font-bold text-[#F4F4F5] mt-1.5 mb-1">
              {m.label}
            </h2>
            <p class="text-xs text-[#A1A1AA] leading-relaxed">
              {m.desc}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Career Timeline Cards -->
    <div class="mb-24 flex flex-col gap-8">
      {
        experienceList.map((exp, index) => {
          const isCurrent = index === 0;
          return (
            <div
              class:list={[
                "hover-card group relative overflow-hidden rounded-[28px] border transition-all duration-300",
                isCurrent
                  ? "border-[#38BDF8]/40 bg-gradient-to-b from-[#131B2A] via-[#10141E] to-[#0D1017] p-8 md:p-12 shadow-[0_0_30px_rgba(56,189,248,0.12)] hover:border-[#38BDF8] hover:shadow-[0_0_40px_rgba(56,189,248,0.25)]"
                  : "border-[#26262F] bg-[#13131A] p-8 md:p-12 hover:border-[#3A3A46]"
              ]}
            >
              {isCurrent && (
                <div class="pointer-events-none absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#38BDF8] to-transparent" />
              )}

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Left: Period, Company, Location (4 cols) -->
                <div class="lg:col-span-4 flex flex-col items-start">
                  <div class="flex items-center gap-2 mb-3">
                    <span
                      class:list={[
                        "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider",
                        isCurrent
                          ? "border border-[#38BDF8]/40 bg-[#38BDF8]/15 text-[#38BDF8] shadow-[0_0_12px_rgba(56,189,248,0.2)]"
                          : exp.data.role.includes("Instructor")
                            ? "border border-violet-500/30 bg-violet-500/10 text-violet-300"
                            : "border border-[#26262F] bg-[#1C1C26] text-[#A1A1AA]"
                      ]}
                    >
                      {isCurrent && <span class="h-1.5 w-1.5 rounded-full bg-[#38BDF8] animate-pulse" />}
                      {isCurrent ? "Current Role" : exp.data.role.includes("Instructor") ? "Teaching & Mentorship" : "Past Position"}
                    </span>
                  </div>

                  <span class="font-['Space_Grotesk'] text-xl md:text-2xl font-bold text-[#38BDF8] mb-1">
                    {exp.data.period}
                  </span>

                  <h3 class="font-['Space_Grotesk'] text-lg font-bold text-[#F4F4F5] mt-2">
                    {exp.data.company}
                  </h3>

                  <span class="flex items-center gap-1.5 text-xs text-[#A1A1AA] mt-1">
                    <svg class="h-3.5 w-3.5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    {exp.data.location}
                  </span>
                </div>

                <!-- Right: Role Title & Accomplishment Bullets (8 cols) -->
                <div class="lg:col-span-8 flex flex-col border-t lg:border-t-0 lg:border-l border-[#26262F] pt-6 lg:pt-0 lg:pl-8">
                  <h2 class="font-['Space_Grotesk'] text-2xl md:text-3xl font-extrabold text-[#F4F4F5] mb-5">
                    {exp.data.role}
                  </h2>

                  <ul class="flex flex-col gap-3.5 text-sm md:text-base leading-relaxed text-[#A1A1AA]">
                    {exp.data.bullets.map((bullet) => (
                      <li class="flex items-start gap-3">
                        <span class="text-[#38BDF8] mt-1 shrink-0 text-xs">✦</span>
                        <span class="text-[#D4D4D8]">{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- PM Methodology & Tooling Grid -->
    <div class="rounded-[28px] border border-[#26262F] bg-[#13131A] p-8 md:p-12 mb-20 shadow-xl">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 mb-8">
        <div>
          <span class="label-caps mb-2">Technical Tooling & Frameworks</span>
          <h2 class="section-h2 text-[#F4F4F5]">
            Methods & Execution Stack
          </h2>
        </div>
        <p class="text-sm text-[#A1A1AA] max-w-lg">
          Discipline beats intuition in software delivery. I leverage industry-standard systems to forecast team capacity, eliminate impediments, and report progress transparently.
        </p>
      </div>

      <div class="flex flex-wrap gap-2.5">
        {
          pmToolstack.map((tool) => (
            <span class="inline-flex items-center gap-2 rounded-xl border border-[#26262F] bg-[#1C1C26] px-4 py-2.5 text-xs font-semibold text-[#F4F4F5] transition-all hover:border-[#38BDF8] hover:text-[#38BDF8] hover:scale-105">
              <span class="h-1.5 w-1.5 rounded-full bg-[#38BDF8]"></span>
              {tool}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Bottom Navigation / Call To Action -->
    <div class="rounded-[28px] border border-[#38BDF8]/30 bg-gradient-to-r from-[#131B2A] via-[#10141E] to-[#131B2A] p-8 md:p-12 shadow-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <span class="label-caps mb-2">Next Step</span>
        <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5]">
          Explore real client case studies delivered on time.
        </h3>
        <p class="text-sm text-[#A1A1AA] mt-1">
          Deep dives into API distribution architectures, multi-tenant booking platforms, and high-velocity team turnarounds.
        </p>
      </div>

      <div class="flex items-center gap-4 shrink-0">
        <a
          href="/projects"
          class="hover-btn inline-flex min-h-[46px] items-center justify-center gap-2 rounded-full bg-[#38BDF8] px-6 py-2.5 text-xs font-bold text-[#0A0A0F] shadow-[0_0_20px_rgba(56,189,248,0.3)] transition-all hover:bg-white"
        >
          <span>View Case Studies</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="/education"
          class="hover-btn inline-flex min-h-[46px] items-center justify-center rounded-full border border-[#3A3A46] bg-[#13131A] px-6 py-2.5 text-xs font-semibold text-[#F4F4F5] transition-all hover:border-[#38BDF8]"
        >
          Academic Credentials
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
