---
---

<section class="reveal-on-scroll relative overflow-hidden py-20 md:py-28" aria-label="Featured Projects">
  <!-- Atmospheric Background & Tech Architecture Image Layer -->
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <!-- Glowing Top Technical Horizon Line -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 h-[1px] w-3/4 max-w-[900px] bg-gradient-to-r from-transparent via-[#38BDF8]/40 to-transparent"></div>

    <!-- 3D Software Architecture & Data Streams Background Image -->
    <img
      src="/projects-bg.jpg"
      alt=""
      class="h-full w-full object-cover object-top opacity-40 select-none scale-105"
      loading="lazy"
      decoding="async"
    />

    <!-- Deep Gradient Overlays to preserve card contrast & blend seamlessly into #0A0A0F -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0F] via-transparent to-[#0A0A0F]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0F]/80 via-transparent to-[#0A0A0F]/80"></div>
    <div class="absolute inset-0 bg-[#0A0A0F]/30 backdrop-blur-[0.5px]"></div>

    <!-- Ambient Cyan & Violet Radial Glow Orbs -->
    <div class="absolute -top-24 left-1/4 h-[420px] w-[500px] -translate-x-1/2 rounded-full bg-[#38BDF8]/15 blur-[120px]"></div>
    <div class="absolute top-1/3 -right-20 h-[520px] w-[520px] rounded-full bg-[#8B7CF6]/15 blur-[130px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1120px] px-6">
    <!-- Section Heading -->
    <div class="mb-14 flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
      <div>
        <span class="label-caps mb-3">
          <span class="pulsing-dot" aria-hidden="true"></span>
          Delivery Highlights
        </span>
        <h2 class="section-h2 text-[#F4F4F5]">
          Projects I'm proud of.
        </h2>
      </div>
      <a
        href="/projects"
        class="group inline-flex items-center gap-2 text-sm font-semibold text-[#38BDF8] transition-colors hover:text-[#F4F4F5]"
      >
        <span>View all case studies</span>
        <svg
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Featured Projects Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Card 1: Large Featured Card (spans 2 columns on desktop) -->
      <a
        href="/projects/flight-booking-engine-latency"
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[28px] border border-[#26262F] bg-[#13131A] p-8 md:p-10 lg:col-span-2 transition-all"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Text Content (Left: 7 cols) -->
          <div class="lg:col-span-7 flex flex-col items-start">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="font-['Space_Grotesk'] text-xs font-bold uppercase tracking-wider text-[#38BDF8]">
                CASE STUDY 01
              </span>
              <span class="text-[#3A3A46]">·</span>
              <span class="rounded-full border border-[#26262F] bg-[#1C1C26] px-3 py-1 text-xs font-medium text-[#A1A1AA]">
                Client: Confidential
              </span>
              <span class="text-xs text-[#A1A1AA]">High-throughput API aggregator in [region]</span>
            </div>

            <h3 class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold tracking-tight text-[#F4F4F5] transition-colors group-hover:text-[#38BDF8]">
              Reduced flight booking latency by [ADD: 42%] across multi-airline search queries
            </h3>

            <p class="mt-4 text-base leading-relaxed text-[#A1A1AA]">
              Re-engineered sprint sequencing and API contract validations for a regional flight aggregator, aligning 12 engineers and 3 external GDS providers to launch 2 weeks ahead of schedule.
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#38BDF8]/10 border border-[#38BDF8]/30 px-3.5 py-1.5 text-xs font-bold text-[#38BDF8]">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                Result: [ADD: 42%] faster search response
              </span>
              <span class="text-xs text-[#A1A1AA]">Delivery & API Integration</span>
            </div>
          </div>

          <!-- Decorative Mini Kanban Board Illustration (Right: 5 cols) -->
          <div
            class="lg:col-span-5 relative w-full rounded-2xl border border-[#26262F] bg-[#0E0E14] p-5 shadow-inner"
            aria-hidden="true"
          >
            <div class="flex items-center justify-between border-b border-[#26262F] pb-3 mb-4 text-[11px] font-bold uppercase tracking-wider text-[#A1A1AA]">
              <span>Sprint Kanban</span>
              <span class="flex items-center gap-1.5 text-[#38BDF8]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#38BDF8]"></span>
                In Flight
              </span>
            </div>

            <div class="grid grid-cols-3 gap-2.5">
              <!-- Column 1: Ready -->
              <div class="flex flex-col gap-2 rounded-xl bg-[#13131A] p-2.5 border border-[#26262F]/60">
                <span class="text-[10px] font-bold text-[#A1A1AA] uppercase">Plan</span>
                <div class="rounded-lg bg-[#1C1C26] p-2">
                  <div class="h-2 w-10/12 rounded bg-[#3A3A46] mb-1.5"></div>
                  <div class="h-1.5 w-7/12 rounded bg-[#26262F]"></div>
                </div>
                <div class="rounded-lg bg-[#1C1C26] p-2">
                  <div class="h-2 w-9/12 rounded bg-[#3A3A46]"></div>
                </div>
              </div>

              <!-- Column 2: In Dev (Violet) -->
              <div class="flex flex-col gap-2 rounded-xl bg-[#13131A] p-2.5 border border-[#8B7CF6]/30">
                <span class="text-[10px] font-bold text-[#8B7CF6] uppercase">In Dev</span>
                <div class="rounded-lg bg-[#1C1C26] p-2 border-l-2 border-[#8B7CF6]">
                  <div class="h-2 w-11/12 rounded bg-[#8B7CF6]/80 mb-1.5"></div>
                  <div class="flex items-center justify-between">
                    <div class="h-1.5 w-6/12 rounded bg-[#3A3A46]"></div>
                    <div class="h-2.5 w-2.5 rounded-full bg-[#8B7CF6]"></div>
                  </div>
                </div>
              </div>

              <!-- Column 3: Shipped (Cyan) -->
              <div class="flex flex-col gap-2 rounded-xl bg-[#13131A] p-2.5 border border-[#38BDF8]/30">
                <span class="text-[10px] font-bold text-[#38BDF8] uppercase">Shipped</span>
                <div class="rounded-lg bg-[#1C1C26] p-2 border-l-2 border-[#38BDF8]">
                  <div class="h-2 w-10/12 rounded bg-[#38BDF8] mb-1.5"></div>
                  <div class="flex items-center justify-between">
                    <div class="h-1.5 w-5/12 rounded bg-[#3A3A46]"></div>
                    <svg class="h-3 w-3 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
                <div class="rounded-lg bg-[#1C1C26] p-2 border-l-2 border-[#38BDF8]">
                  <div class="h-2 w-8/12 rounded bg-[#38BDF8]"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-end text-sm font-semibold text-[#38BDF8]">
          <span class="inline-flex items-center gap-1 group-hover:underline">
            Read case study
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </div>
      </a>

      <!-- Card 2: Solid Cyan Card -->
      <a
        href="/projects/hotel-inventory-distribution-sync"
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[28px] bg-[#38BDF8] p-8 md:p-9 text-[#0A0A0F] shadow-lg transition-all"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="font-['Space_Grotesk'] text-xs font-bold uppercase tracking-wider text-[#0A0A0F]/80">
              CASE STUDY 02
            </span>
            <span class="rounded-full border border-[#0A0A0F]/20 bg-[#0A0A0F]/10 px-3 py-1 text-xs font-semibold text-[#0A0A0F]">
              Client: Confidential
            </span>
          </div>

          <!-- Big Result Number -->
          <div class="my-4">
            <span class="font-['Space_Grotesk'] text-5xl font-extrabold tracking-tight text-[#0A0A0F]">
              [ADD: 99.9%]
            </span>
            <p class="text-xs font-semibold uppercase tracking-wider text-[#0A0A0F]/70 mt-1">
              Inventory Sync Accuracy Across [ADD: 200+] Hotel Endpoints
            </p>
          </div>

          <h3 class="font-['Space_Grotesk'] text-2xl font-bold tracking-tight text-[#0A0A0F] mt-3">
            Real-time hotel inventory distribution synchronized with zero booking collisions
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#0A0A0F]/85">
            Orchestrated continuous reconciliation cycles for an e-commerce platform in [region], cutting stale inventory sync errors to near zero.
          </p>
        </div>

        <!-- Decorative Progress Bar Illustration -->
        <div class="mt-8 pt-5 border-t border-[#0A0A0F]/15" aria-hidden="true">
          <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-[#0A0A0F]/80 mb-2">
            <span>Sync Pipeline Status</span>
            <span>100% Shipped</span>
          </div>
          <div class="h-3 w-full rounded-full bg-[#0A0A0F]/15 p-0.5">
            <div class="h-full rounded-full bg-[#0A0A0F] transition-all" style="width: 100%;"></div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[10px] font-semibold text-[#0A0A0F]/70">
            <span>API Gateways</span>
            <span>Payload Parser</span>
            <span>Active Deploy</span>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between pt-2">
          <span class="text-xs font-bold text-[#0A0A0F] uppercase tracking-wider">Client: High-volume platform in [region]</span>
          <span class="inline-flex items-center gap-1 text-sm font-bold text-[#0A0A0F] group-hover:underline">
            View details →
          </span>
        </div>
      </a>

      <!-- Card 3: Dark Card with Gantt-style Illustration -->
      <a
        href="/projects/travel-erp-migration-delivery"
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[28px] border border-[#26262F] bg-[#13131A] p-8 md:p-9 transition-all"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="font-['Space_Grotesk'] text-xs font-bold uppercase tracking-wider text-[#38BDF8]">
              CASE STUDY 03
            </span>
            <span class="rounded-full border border-[#26262F] bg-[#1C1C26] px-3 py-1 text-xs font-medium text-[#A1A1AA]">
              Client: Confidential
            </span>
          </div>

          <!-- Cyan Result Number -->
          <div class="my-4">
            <span class="font-['Space_Grotesk'] text-5xl font-bold tracking-tight text-[#38BDF8]">
              [ADD: 0 Days]
            </span>
            <p class="text-xs font-semibold uppercase tracking-wider text-[#A1A1AA] mt-1">
              Downtime during core system migration
            </p>
          </div>

          <h3 class="font-['Space_Grotesk'] text-2xl font-bold tracking-tight text-[#F4F4F5] transition-colors group-hover:text-[#38BDF8]">
            Cutover of mission-critical enterprise ERP completed with zero transaction interruption
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#A1A1AA]">
            Led release planning, mock rehearsals, and midnight deployment cutover for an enterprise operations client in [region], migrating thousands of live transactions seamlessly.
          </p>
        </div>

        <!-- Decorative Gantt-Style Bar Illustration -->
        <div class="mt-8 rounded-2xl border border-[#26262F] bg-[#0E0E14] p-4 shadow-inner" aria-hidden="true">
          <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-[#A1A1AA] mb-3">
            <span>Cutover Sequence</span>
            <span class="text-[#38BDF8]">Milestone 4/4</span>
          </div>

          <div class="flex flex-col gap-2">
            <!-- Row 1: Discovery & Architecture -->
            <div class="flex items-center gap-2 text-[10px] text-[#A1A1AA]">
              <span class="w-16 truncate">Audit</span>
              <div class="h-2 rounded bg-[#3A3A46]" style="width: 40%;"></div>
            </div>

            <!-- Row 2: Staging & Rehearsal (Violet) -->
            <div class="flex items-center gap-2 text-[10px] text-[#A1A1AA]">
              <span class="w-16 truncate">Rehearsal</span>
              <div class="ml-[25%] h-2 rounded bg-[#8B7CF6]" style="width: 45%;"></div>
            </div>

            <!-- Row 3: Live Cutover (Cyan) -->
            <div class="flex items-center gap-2 text-[10px] text-[#38BDF8] font-semibold">
              <span class="w-16 truncate text-[#38BDF8]">Cutover</span>
              <div class="ml-[65%] h-2.5 rounded bg-[#38BDF8] shadow-[0_0_8px_rgba(56,189,248,0.4)]" style="width: 35%;"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between pt-2">
          <span class="text-xs text-[#A1A1AA]">Client: Enterprise operations client in [region]</span>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-[#38BDF8] group-hover:underline">
            View details →
          </span>
        </div>
      </a>

      <!-- Card 4: Multi-Module B2B Travel Platform (spans 2 columns on desktop) -->
      <a
        href="/projects/b2b-travel-reservation-portal"
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[28px] border border-[#26262F] bg-gradient-to-br from-[#13131A] via-[#101524] to-[#0D1117] p-8 md:p-10 lg:col-span-2 transition-all hover:border-cyan-500/40"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Text Content (Left: 7 cols) -->
          <div class="lg:col-span-7 flex flex-col items-start">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="font-['Space_Grotesk'] text-xs font-bold uppercase tracking-wider text-cyan-400">
                CASE STUDY 04
              </span>
              <span class="text-[#3A3A46]">·</span>
              <span class="rounded-full border border-[#26262F] bg-[#1C1C26] px-3 py-1 text-xs font-medium text-[#A1A1AA]">
                Client: Confidential
              </span>
              <span class="text-xs text-[#A1A1AA]">Enterprise B2B Travel Platform</span>
            </div>

            <h3 class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold tracking-tight text-[#F4F4F5] transition-colors group-hover:text-cyan-300">
              Architected & Delivered Multi-Service B2B Travel Portal (Flight, Hotel, Visa, Tour & eSIM)
            </h3>

            <p class="mt-4 text-base leading-relaxed text-[#A1A1AA]">
              Consolidated 5 disparate travel reservation modules into a high-performance agent platform—featuring multi-GDS flight ticketing, real-time bed-bank hotel feeds, automated visa application tracking, custom holiday tours, and international eSIM provisioning.
            </p>

            <!-- Module Tags -->
            <div class="mt-6 flex flex-wrap items-center gap-2">
              <span class="rounded-lg border border-[#26262F] bg-[#161B26] px-3 py-1 text-xs font-semibold text-[#F4F4F5]">✈️ Flight Engine</span>
              <span class="rounded-lg border border-[#26262F] bg-[#161B26] px-3 py-1 text-xs font-semibold text-[#F4F4F5]">🏨 Hotel Aggregator</span>
              <span class="rounded-lg border border-[#26262F] bg-[#161B26] px-3 py-1 text-xs font-semibold text-[#F4F4F5]">🛂 Visa Processing</span>
              <span class="rounded-lg border border-[#26262F] bg-[#161B26] px-3 py-1 text-xs font-semibold text-[#F4F4F5]">🏖️ Holiday Tours</span>
              <span class="rounded-lg border border-cyan-500/30 bg-cyan-950/40 px-3 py-1 text-xs font-semibold text-cyan-300">📶 eSIM Roaming</span>
            </div>
          </div>

          <!-- Interactive Module Showcase Illustration (Right: 5 cols) -->
          <div
            class="lg:col-span-5 relative w-full rounded-2xl border border-cyan-500/20 bg-[#090D16] p-5 shadow-[0_0_25px_rgba(6,182,212,0.1)]"
            aria-hidden="true"
          >
            <div class="flex items-center justify-between border-b border-[#26262F] pb-3 mb-4 text-[11px] font-bold uppercase tracking-wider text-[#A1A1AA]">
              <span>B2B Portal Modules</span>
              <span class="flex items-center gap-1.5 text-cyan-400">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                Active Production
              </span>
            </div>

            <div class="space-y-2.5">
              <div class="flex items-center justify-between rounded-xl border border-[#26262F] bg-[#131722] p-2.5 text-xs text-[#F4F4F5]">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
                  <span class="font-medium">Multi-GDS Flight Booking</span>
                </div>
                <span class="text-[11px] font-mono text-cyan-300">&lt; 1.4s API</span>
              </div>
              <div class="flex items-center justify-between rounded-xl border border-[#26262F] bg-[#131722] p-2.5 text-xs text-[#F4F4F5]">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-[#38BDF8]"></span>
                  <span class="font-medium">Hotel Bed-Bank Sync</span>
                </div>
                <span class="text-[11px] font-mono text-[#38BDF8]">Zero Overbook</span>
              </div>
              <div class="flex items-center justify-between rounded-xl border border-[#26262F] bg-[#131722] p-2.5 text-xs text-[#F4F4F5]">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-[#8B7CF6]"></span>
                  <span class="font-medium">Visa & Custom Tours</span>
                </div>
                <span class="text-[11px] font-mono text-[#8B7CF6]">Automated ATS</span>
              </div>
              <div class="flex items-center justify-between rounded-xl border border-[#26262F] bg-[#131722] p-2.5 text-xs text-[#F4F4F5]">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                  <span class="font-medium">eSIM & Agent Wallet</span>
                </div>
                <span class="text-[11px] font-mono text-emerald-400">Instant QR</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between pt-2">
          <span class="text-xs text-[#A1A1AA]">Client: Enterprise B2B Travel Platform</span>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-cyan-300 group-hover:underline">
            Explore full case study
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
