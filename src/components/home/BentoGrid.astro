---
import { siteConfig } from "../../config/site";

const tools = [
  "Jira",
  "ClickUp",
  "Notion",
  "Slack",
  "Figma",
  "Postman",
  "Linear",
  "Miro",
  "GitHub",
  "Confluence",
];
---

<section class="reveal-on-scroll py-20 md:py-28" aria-label="About & Highlights">
  <div class="mx-auto max-w-[1120px] px-6">
    <!-- Section Header -->
    <div class="mb-12 flex flex-col items-start">
      <span class="label-caps mb-3">
        <span class="pulsing-dot" aria-hidden="true"></span>
        Core Profile & Metrics
      </span>
      <h2 class="section-h2 text-[#F4F4F5]">
        Calm execution. Measurable delivery.
      </h2>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-5">
      <!-- Card 1: About card (spans 2 columns on tablet & desktop) -->
      <div
        class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-2 lg:col-span-2"
      >
        <div class="flex items-center gap-4 mb-6">
          <!-- Portrait Avatar Graphic -->
          <div class="relative flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-[#1C1C26] to-[#26262F] border border-[#3A3A46] text-[#C6F432] shadow-inner">
            <span class="font-['Space_Grotesk'] text-2xl font-bold tracking-tight">AI</span>
            <span class="absolute -bottom-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-[#0A0A0F]">
              <span class="h-2.5 w-2.5 rounded-full bg-[#C6F432]"></span>
            </span>
          </div>
          <div>
            <h3 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5]">
              {siteConfig.name}
            </h3>
            <p class="text-sm text-[#C6F432] font-medium">
              {siteConfig.title} · {siteConfig.company}
            </p>
          </div>
        </div>

        <p class="text-[0.975rem] leading-relaxed text-[#A1A1AA] mb-6">
          I orchestrate high-stakes software initiatives where engineering precision meets commercial deadlines. With a strong Computer Science and Engineering foundation, I turn ambiguous requirements into structured backlogs, cross-functional harmony, and reliable production releases.
        </p>

        <div class="pt-4 border-t border-[#26262F] flex items-center justify-between">
          <span class="text-xs text-[#A1A1AA] uppercase tracking-wider font-semibold">Specialization</span>
          <span class="text-xs text-[#F4F4F5] bg-[#1C1C26] px-3 py-1.5 rounded-full border border-[#26262F]">
            Software Engineering & API Delivery
          </span>
        </div>
      </div>

      <!-- Card 2: Big-Number Metric Card 1 -->
      <div
        class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-1"
      >
        <span class="text-xs uppercase tracking-wider text-[#A1A1AA] font-semibold">
          Sprint Reliability
        </span>
        <div class="my-6">
          <div class="font-['Space_Grotesk'] text-4xl sm:text-5xl font-bold tracking-tight text-[#C6F432]">
            [ADD: 98%]
          </div>
          <p class="mt-2 text-sm text-[#A1A1AA]">
            [ADD: On-time milestone completion rate across client releases]
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs text-[#C6F432] font-medium">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <span>Measured on production deploys</span>
        </div>
      </div>

      <!-- Card 3: Big-Number Metric Card 2 -->
      <div
        class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-1"
      >
        <span class="text-xs uppercase tracking-wider text-[#A1A1AA] font-semibold">
          Launch Overruns
        </span>
        <div class="my-6">
          <div class="font-['Space_Grotesk'] text-4xl sm:text-5xl font-bold tracking-tight text-[#C6F432]">
            [ADD: 0]
          </div>
          <p class="mt-2 text-sm text-[#A1A1AA]">
            [ADD: Critical unmitigated scope leaks on scheduled go-lives]
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs text-[#C6F432] font-medium">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Proactive risk framework</span>
        </div>
      </div>

      <!-- Card 4: "NOW" Status Card -->
      <div
        class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-1 lg:col-span-2"
      >
        <div class="flex items-center justify-between">
          <span class="text-xs uppercase tracking-wider text-[#A1A1AA] font-semibold">Current Focus</span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#C6F432]/30 bg-[#C6F432]/10 px-3 py-1 text-xs font-semibold text-[#C6F432]">
            <span class="pulsing-dot" aria-hidden="true"></span>
            ACTIVE NOW
          </span>
        </div>

        <div class="my-5">
          <h4 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5]">
            Project Manager at Innovate Solution
          </h4>
          <p class="mt-2 text-sm text-[#A1A1AA]">
            Leading cross-functional software delivery for international technology clients, aligning engineering teams, QA, and client stakeholders.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-xs text-[#A1A1AA]">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-[#C6F432]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Based in Bangladesh
          </span>
          <span class="text-[#26262F]">·</span>
          <span>Scalable Cloud & Web Systems</span>
        </div>
      </div>

      <!-- Card 5: Tools Card (spans 2 columns) -->
      <div
        class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-2 lg:col-span-2"
      >
        <div>
          <span class="text-xs uppercase tracking-wider text-[#A1A1AA] font-semibold">
            Delivery Stack & Workflows
          </span>
          <h4 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5] mt-1 mb-5">
            Tools I use to maintain clarity and velocity
          </h4>
        </div>

        <!-- Outlined Chips -->
        <div class="flex flex-wrap gap-2.5">
          {
            tools.map((tool) => (
              <span class="inline-flex items-center rounded-xl border border-[#26262F] bg-[#1C1C26]/70 px-3.5 py-1.5 text-xs font-medium text-[#F4F4F5] transition-colors hover:border-[#C6F432] hover:text-[#C6F432]">
                {tool}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
