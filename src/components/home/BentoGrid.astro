---
import { siteConfig } from "../../config/site";

const tools = [
  "Jira",
  "ClickUp",
  "Notion",
  "Slack",
  "Figma",
  "Postman",
  "Linear",
  "Miro",
  "GitHub",
  "Confluence",
];
---

<section class="reveal-on-scroll py-20 md:py-28" aria-label="About & Highlights">
  <div class="mx-auto max-w-[1280px] px-6">
    <!-- Section Header -->
    <div class="mb-12 flex flex-col items-start">
      <span class="label-caps mb-3">
        <span class="pulsing-dot" aria-hidden="true"></span>
        Core Profile & Metrics
      </span>
      <h2 class="section-h2 text-[#F4F4F5]">
        Calm execution. Measurable delivery.
      </h2>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-5">
      <!-- Card 1: About card (spans 2 columns on tablet & desktop) -->
      <a
        href="/about"
        class="hover-card group flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-2 lg:col-span-2 transition-all hover:border-[#38BDF8]/60 hover:shadow-[0_0_30px_rgba(56,189,248,0.12)] cursor-pointer"
        aria-label="Learn more about Akhirul Islam on the About page"
      >
        <div class="flex items-center gap-4 mb-6">
          <!-- Portrait Avatar Graphic -->
          <div class="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-cyan-500/30 bg-[#0B0F19] shadow-[0_0_20px_rgba(6,182,212,0.25)] transition-transform duration-300 group-hover:scale-105">
            <img
              src={siteConfig.avatar}
              alt={siteConfig.name}
              width="64"
              height="64"
              class="h-full w-full object-cover object-top"
            />
            <span class="absolute -bottom-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-[#0A0A0F]">
              <span class="h-2.5 w-2.5 rounded-full bg-[#38BDF8]"></span>
            </span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5] transition-colors group-hover:text-[#38BDF8]">
                {siteConfig.name}
              </h3>
              <svg class="h-4 w-4 text-[#38BDF8] opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
            <p class="text-sm text-[#38BDF8] font-medium">
              {siteConfig.title} · {siteConfig.company}
            </p>
          </div>
        </div>

        <p class="text-[0.975rem] leading-relaxed text-[#A1A1AA] mb-6">
          I orchestrate high-stakes software initiatives where engineering precision meets commercial deadlines. With a strong Computer Science and Engineering foundation, I turn ambiguous requirements into structured backlogs, cross-functional harmony, and reliable production releases.
        </p>

        <div class="pt-4 border-t border-[#26262F] flex items-center justify-between">
          <span class="text-xs text-[#A1A1AA] uppercase tracking-wider font-semibold">Specialization</span>
          <div class="flex items-center gap-2">
            <span class="text-xs text-[#F4F4F5] bg-[#1C1C26] px-3 py-1.5 rounded-full border border-[#26262F] transition-colors group-hover:border-[#38BDF8]/40">
              Software Engineering & API Delivery
            </span>
            <span class="text-xs font-semibold text-[#38BDF8] hidden sm:inline-flex items-center gap-1 group-hover:underline">
              About me →
            </span>
          </div>
        </div>
      </a>

      <!-- Card 2: Big-Number Metric Card 1 - Sprint Reliability -->
      <div
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[26px] border border-[#26262F] bg-gradient-to-b from-[#131B2A]/90 to-[#10141E] p-7 md:col-span-1 shadow-lg transition-all duration-300 hover:border-[#38BDF8]/60 hover:shadow-[0_0_30px_rgba(56,189,248,0.2)]"
      >
        <div class="flex items-center justify-between">
          <span class="text-xs uppercase tracking-wider text-[#38BDF8] font-bold">
            Sprint Reliability
          </span>
          <span class="flex h-2 w-2 relative">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#38BDF8] opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[#38BDF8]"></span>
          </span>
        </div>

        <div class="my-5">
          <div class="font-['Space_Grotesk'] text-4xl sm:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-[#38BDF8] via-sky-200 to-white">
            98.5%
          </div>
          <h5 class="text-xs font-bold uppercase tracking-wider text-[#F4F4F5] mt-2 mb-1">
            On-Time Milestone Velocity
          </h5>
          <p class="text-xs leading-relaxed text-[#A1A1AA]">
            Sustained completion rate across production releases through disciplined sprint capacity planning and zero debt.
          </p>
        </div>

        <div class="flex items-center gap-2 pt-3 border-t border-[#26262F] text-[11px] text-[#38BDF8] font-semibold">
          <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <span>Measured on live deployments</span>
        </div>
      </div>

      <!-- Card 3: Big-Number Metric Card 2 - Launch Integrity & Zero Overruns -->
      <div
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[26px] border border-[#26262F] bg-gradient-to-b from-[#131B2A]/90 to-[#10141E] p-7 md:col-span-1 shadow-lg transition-all duration-300 hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.18)]"
      >
        <div class="flex items-center justify-between">
          <span class="text-xs uppercase tracking-wider text-emerald-400 font-bold">
            Launch Integrity
          </span>
          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-400">
            Zero Drift
          </span>
        </div>

        <div class="my-5">
          <div class="font-['Space_Grotesk'] text-4xl sm:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-200 to-white">
            Zero
          </div>
          <h5 class="text-xs font-bold uppercase tracking-wider text-[#F4F4F5] mt-2 mb-1">
            Unplanned Launch Overruns
          </h5>
          <p class="text-xs leading-relaxed text-[#A1A1AA]">
            Preemptive scope containment, technical dependency mapping, and zero unmitigated blockers on go-live dates.
          </p>
        </div>

        <div class="flex items-center gap-2 pt-3 border-t border-[#26262F] text-[11px] text-emerald-400 font-semibold">
          <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>100% On-Schedule Go-Lives</span>
        </div>
      </div>

      <!-- Card 4: "NOW" Status Card -->
      <div
        class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-1 lg:col-span-2"
      >
        <div class="flex items-center justify-between">
          <span class="text-xs uppercase tracking-wider text-[#A1A1AA] font-semibold">Current Focus</span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#38BDF8]/30 bg-[#38BDF8]/10 px-3 py-1 text-xs font-semibold text-[#38BDF8]">
            <span class="pulsing-dot" aria-hidden="true"></span>
            ACTIVE NOW
          </span>
        </div>

        <div class="my-5">
          <h4 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5]">
            Project Manager at Innovate Solution
          </h4>
          <p class="mt-2 text-sm text-[#A1A1AA]">
            Leading cross-functional software delivery for international technology clients, aligning engineering teams, QA, and client stakeholders.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-xs text-[#A1A1AA]">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Based in Bangladesh
          </span>
          <span class="text-[#26262F]">·</span>
          <span>Scalable Cloud & Web Systems</span>
        </div>
      </div>

      <!-- Card 5: Tools Card (spans 2 columns) -->
      <div
        class="hover-card flex flex-col justify-between rounded-[26px] border border-[#26262F] bg-[#13131A] p-7 md:col-span-2 lg:col-span-2"
      >
        <div>
          <span class="text-xs uppercase tracking-wider text-[#A1A1AA] font-semibold">
            Delivery Stack & Workflows
          </span>
          <h4 class="font-['Space_Grotesk'] text-xl font-bold text-[#F4F4F5] mt-1 mb-5">
            Tools I use to maintain clarity and velocity
          </h4>
        </div>

        <!-- Outlined Chips -->
        <div class="flex flex-wrap gap-2.5">
          {
            tools.map((tool) => (
              <span class="inline-flex items-center rounded-xl border border-[#26262F] bg-[#1C1C26]/70 px-3.5 py-1.5 text-xs font-medium text-[#F4F4F5] transition-colors hover:border-[#38BDF8] hover:text-[#38BDF8]">
                {tool}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
