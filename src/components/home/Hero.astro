---
import { siteConfig } from "../../config/site";
---

<section class="relative overflow-hidden pt-6 sm:pt-8 md:pt-10 pb-16 md:pb-24">
  <!-- Atmospheric Background Image Layer -->
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <img
      src="/hero-bg.jpg"
      alt=""
      class="h-full w-full object-cover object-right md:object-center opacity-45 select-none scale-105"
      loading="eager"
      decoding="async"
    />
    <!-- Gradient Masks for contrast & seamless transition to site background -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0F] via-[#0A0A0F]/80 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0F] via-transparent to-[#0A0A0F]/50"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0F]/70 via-transparent to-[#0A0A0F]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1120px] px-6">
    <div class="flex flex-col items-start max-w-4xl">
      <!-- Top Announcement / Live Flagship Case Study Pill -->
      <a
        href="/projects/b2b-travel-reservation-portal"
        class="hero-announcement group mb-4 inline-flex max-w-full items-center gap-2.5 rounded-full border border-[#38BDF8]/30 bg-[#0F172A]/85 px-4 py-1.5 text-xs font-medium text-[#F4F4F5] shadow-[0_0_20px_rgba(56,189,248,0.15)] backdrop-blur-md transition-all hover:border-[#38BDF8] hover:bg-[#1E293B]/90 hover:shadow-[0_0_28px_rgba(56,189,248,0.3)] hover:scale-[1.02]"
      >
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#38BDF8]/20 px-2.5 py-0.5 text-[11px] font-bold text-[#38BDF8]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#38BDF8] animate-pulse"></span>
          NEW CASE STUDY
        </span>
        <span class="truncate text-[#E2E8F0] group-hover:text-white">
          Multi-Service B2B Travel Reservation Portal Architecture
        </span>
        <svg
          class="h-3.5 w-3.5 shrink-0 text-[#38BDF8] transition-transform duration-200 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Pill Badge with Pulsing Sky Cyan Dot -->
      <div
        class="hero-badge inline-flex items-center gap-2.5 rounded-full border border-[#26262F] bg-[#13131A]/90 px-4 py-2 text-xs font-semibold tracking-wide text-[#F4F4F5] shadow-sm backdrop-blur-sm"
      >
        <span class="pulsing-dot" aria-hidden="true"></span>
        <span>Technical Project Manager · B.Sc. in CSE · {siteConfig.location}</span>
      </div>

      <!-- Main Display Headline -->
      <h1 class="hero-title hero-h1 mt-7 font-['Space_Grotesk'] text-[#F4F4F5]">
        I don't just manage projects. I <span class="relative inline-block text-[#F4F4F5]">
          ship
          <svg
            class="underline-svg absolute -bottom-2 left-0 w-full overflow-visible"
            height="12"
            viewBox="0 0 100 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M2 9.5C28 3.5 72 3.5 98 8.5"
              stroke="#38BDF8"
              stroke-width="4"
              stroke-linecap="round"
            />
          </svg>
        </span> them.
      </h1>

      <!-- Intro Line -->
      <p class="hero-intro body-lead mt-8 text-[#A1A1AA]">
        {siteConfig.introLine}
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions mt-10 flex flex-wrap items-center gap-4">
        <!-- Primary Button -->
        <a
          href="/projects"
          class="hover-btn group inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-full bg-[#38BDF8] px-7 py-3 text-base font-bold text-[#0A0A0F] shadow-[0_0_24px_rgba(56,189,248,0.25)] transition-all"
        >
          <span>Explore Case Studies</span>
          <svg
            class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Secondary Button -->
        <a
          href="/about"
          class="hover-btn inline-flex min-h-[48px] items-center justify-center rounded-full border border-[#3A3A46] bg-[#13131A]/60 px-7 py-3 text-base font-semibold text-[#F4F4F5] transition-all hover:border-[#38BDF8] hover:bg-[#13131A]"
        >
          How I Work
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Entrance animations */
  .hero-announcement {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-badge {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.08s forwards;
    opacity: 0;
  }

  .hero-title {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.16s forwards;
    opacity: 0;
  }

  .hero-intro {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.28s forwards;
    opacity: 0;
  }

  .hero-actions {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
    opacity: 0;
  }

  /* Animated underline draw on "ship" */
  .underline-svg path {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    animation: drawUnderline 0.9s cubic-bezier(0.25, 1, 0.5, 1) 0.75s forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drawUnderline {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-announcement,
    .hero-badge,
    .hero-title,
    .hero-intro,
    .hero-actions {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .underline-svg path {
      stroke-dashoffset: 0 !important;
      animation: none !important;
    }
  }
</style>
