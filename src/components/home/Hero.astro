---
import { siteConfig } from "../../config/site";
---

<section class="relative overflow-hidden py-16 md:py-24">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="flex flex-col items-start max-w-4xl">
      <!-- Pill Badge with Pulsing Lime Dot -->
      <div
        class="hero-badge inline-flex items-center gap-2.5 rounded-full border border-[#26262F] bg-[#13131A]/90 px-4 py-2 text-xs font-semibold tracking-wide text-[#F4F4F5] shadow-sm backdrop-blur-sm"
      >
        <span class="pulsing-dot" aria-hidden="true"></span>
        <span>Technical Project Manager · B.Sc. in CSE · {siteConfig.location}</span>
      </div>

      <!-- Main Display Headline -->
      <h1 class="hero-title hero-h1 mt-7 font-['Space_Grotesk'] text-[#F4F4F5]">
        I don't just manage projects. I <span class="relative inline-block text-[#F4F4F5]">
          ship
          <svg
            class="underline-svg absolute -bottom-2 left-0 w-full overflow-visible"
            height="12"
            viewBox="0 0 100 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M2 9.5C28 3.5 72 3.5 98 8.5"
              stroke="#C6F432"
              stroke-width="4"
              stroke-linecap="round"
            />
          </svg>
        </span> them.
      </h1>

      <!-- Intro Line -->
      <p class="hero-intro body-lead mt-8 text-[#A1A1AA]">
        {siteConfig.introLine}
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions mt-10 flex flex-wrap items-center gap-4">
        <!-- Primary Button -->
        <a
          href="/projects"
          class="hover-btn group inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-full bg-[#C6F432] px-7 py-3 text-base font-bold text-[#0A0A0F] shadow-[0_0_24px_rgba(198,244,50,0.25)] transition-all"
        >
          <span>Explore Case Studies</span>
          <svg
            class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Secondary Button -->
        <a
          href="/about"
          class="hover-btn inline-flex min-h-[48px] items-center justify-center rounded-full border border-[#3A3A46] bg-[#13131A]/60 px-7 py-3 text-base font-semibold text-[#F4F4F5] transition-all hover:border-[#C6F432] hover:bg-[#13131A]"
        >
          How I Work
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Entrance animations */
  .hero-badge {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-title {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s forwards;
    opacity: 0;
  }

  .hero-intro {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s forwards;
    opacity: 0;
  }

  .hero-actions {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.36s forwards;
    opacity: 0;
  }

  /* Animated underline draw on "ship" */
  .underline-svg path {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    animation: drawUnderline 0.9s cubic-bezier(0.25, 1, 0.5, 1) 0.75s forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drawUnderline {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge,
    .hero-title,
    .hero-intro,
    .hero-actions {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .underline-svg path {
      stroke-dashoffset: 0 !important;
      animation: none !important;
    }
  }
</style>
