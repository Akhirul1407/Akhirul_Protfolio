---
import { siteConfig } from "../../config/site";
---

<section class="reveal-on-scroll relative overflow-hidden py-20 md:py-28" aria-label="Who Am I">
  <!-- Atmospheric Glow Mesh Background -->
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 h-[450px] w-[700px] rounded-full bg-[#38BDF8]/10 blur-[140px]"></div>
    <div class="absolute bottom-0 right-10 h-[400px] w-[450px] rounded-full bg-[#8B7CF6]/10 blur-[130px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1280px] px-6">
    <!-- Highlighted Section Header -->
    <div class="mb-14 flex flex-col items-start max-w-3xl">
      <!-- Super Highlighted "WHO AM I" Capsule -->
      <div class="inline-flex items-center gap-2.5 rounded-full border border-[#38BDF8]/50 bg-gradient-to-r from-[#38BDF8]/15 to-[#8B7CF6]/15 px-4 py-1.5 text-xs font-extrabold uppercase tracking-widest text-[#38BDF8] shadow-[0_0_24px_rgba(56,189,248,0.35)] backdrop-blur-md mb-4">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#38BDF8] opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#38BDF8]"></span>
        </span>
        <span>WHO AM I</span>
      </div>

      <h2 class="section-h2 text-[#F4F4F5] leading-[1.12]">
        Engineering mindset. <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38BDF8] via-sky-200 to-[#8B7CF6]">Executive project leadership.</span>
      </h2>

      <p class="body-lead mt-5 text-[#A1A1AA] text-base sm:text-lg">
        I am a <strong class="text-[#F4F4F5]">Technical Project Manager</strong> with deep roots as a <strong class="text-[#F4F4F5]">Software Engineer</strong> and a foundational <strong class="text-[#F4F4F5]">B.Sc. in Computer Science and Engineering (CSE)</strong>. I exist at the exact intersection where high-level commercial vision meets complex, production-grade code.
      </p>
    </div>

    <!-- 3 Core Highlighted Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Pillar 1: Project Manager (Sky Cyan Accent) -->
      <div
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[26px] border border-[#38BDF8]/40 bg-gradient-to-b from-[#131B2A] to-[#10141E] p-8 shadow-[0_0_30px_rgba(56,189,248,0.12)] transition-all duration-300 hover:border-[#38BDF8] hover:shadow-[0_0_40px_rgba(56,189,248,0.25)]"
      >
        <!-- Top Glow Accent Line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#38BDF8] to-transparent"></div>

        <div>
          <!-- Header Icon & Tag -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-[#38BDF8]/30 bg-[#38BDF8]/10 text-[#38BDF8] shadow-[0_0_15px_rgba(56,189,248,0.25)]">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <span class="rounded-full border border-[#38BDF8]/30 bg-[#38BDF8]/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#38BDF8]">
              Leadership & Delivery
            </span>
          </div>

          <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mb-3">
            Project Manager
          </h3>

          <p class="text-sm leading-relaxed text-[#A1A1AA] mb-6">
            At {siteConfig.company}, I orchestrate complex software release lifecycles. I translate commercial targets into structured sprint backlogs, shield developer focus from scope creep, coordinate cross-functional teams, and ensure launches land on time with calm execution.
          </p>
        </div>

        <div>
          <!-- Feature Badges -->
          <div class="flex flex-wrap gap-2 pt-5 border-t border-[#26262F]/80">
            <span class="rounded-lg border border-[#26262F] bg-[#161F30] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Agile & Scrum Delivery
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#161F30] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Sprint Velocity & Roadmaps
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#161F30] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Risk & Scope Mitigation
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#161F30] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Calm Production Launches
            </span>
          </div>
        </div>
      </div>

      <!-- Pillar 2: Software Engineer (Violet Accent) -->
      <div
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[26px] border border-[#8B7CF6]/40 bg-gradient-to-b from-[#19152B] to-[#10141E] p-8 shadow-[0_0_30px_rgba(139,124,246,0.12)] transition-all duration-300 hover:border-[#8B7CF6] hover:shadow-[0_0_40px_rgba(139,124,246,0.25)]"
      >
        <!-- Top Glow Accent Line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#8B7CF6] to-transparent"></div>

        <div>
          <!-- Header Icon & Tag -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-[#8B7CF6]/30 bg-[#8B7CF6]/10 text-[#8B7CF6] shadow-[0_0_15px_rgba(139,124,246,0.25)]">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <span class="rounded-full border border-[#8B7CF6]/30 bg-[#8B7CF6]/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#8B7CF6]">
              Technical Depth
            </span>
          </div>

          <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mb-3">
            Software Engineer
          </h3>

          <p class="text-sm leading-relaxed text-[#A1A1AA] mb-6">
            I don't just inspect Gantt charts—I understand the code under the hood. With hands-on engineering acumen, I validate API contracts, evaluate distributed microservices, review database queries, and speak native developer language so problems are resolved before they become bugs.
          </p>
        </div>

        <div>
          <!-- Feature Badges -->
          <div class="flex flex-wrap gap-2 pt-5 border-t border-[#26262F]/80">
            <span class="rounded-lg border border-[#26262F] bg-[#1E1A33] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              API & Microservices Architecture
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#1E1A33] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Code Review & CI/CD Pipelines
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#1E1A33] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Database & Latency Optimization
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#1E1A33] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Technical Debt Prevention
            </span>
          </div>
        </div>
      </div>

      <!-- Pillar 3: Education & CSE Graduate (Emerald / Sky Dual Accent) -->
      <div
        class="hover-card group relative flex flex-col justify-between overflow-hidden rounded-[26px] border border-emerald-500/40 bg-gradient-to-b from-[#0F1E19] to-[#10141E] p-8 shadow-[0_0_30px_rgba(16,185,129,0.12)] transition-all duration-300 hover:border-emerald-400 hover:shadow-[0_0_40px_rgba(16,185,129,0.25)]"
      >
        <!-- Top Glow Accent Line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-emerald-400 to-transparent"></div>

        <div>
          <!-- Header Icon & Tag -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.25)]">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
              </svg>
            </div>
            <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-400">
              Academic Foundation
            </span>
          </div>

          <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-[#F4F4F5] mb-3">
            B.Sc. in CSE Graduate
          </h3>

          <p class="text-sm leading-relaxed text-[#A1A1AA] mb-6">
            Graduated with a Bachelor of Science in <strong class="text-[#F4F4F5]">Computer Science and Engineering</strong>. Trained in fundamental algorithms, data structures, operating systems, network protocols, and software design principles—giving every project decision rock-solid engineering foundations.
          </p>
        </div>

        <div>
          <!-- Feature Badges -->
          <div class="flex flex-wrap gap-2 pt-5 border-t border-[#26262F]/80">
            <span class="rounded-lg border border-[#26262F] bg-[#14261F] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Graduated in CSE
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#14261F] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Algorithms & Data Structures
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#14261F] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Operating Systems & Networks
            </span>
            <span class="rounded-lg border border-[#26262F] bg-[#14261F] px-2.5 py-1 text-xs font-semibold text-[#E2E8F0]">
              Software Engineering Principles
            </span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Highlighted Callout / Value Proposition Bar -->
    <div class="mt-8 rounded-2xl border border-[#26262F] bg-[#13131A]/90 p-6 sm:p-7 shadow-lg backdrop-blur-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <p class="text-sm font-medium text-[#E2E8F0]">
          <strong class="text-[#38BDF8]">The Rare Engineering Crossover:</strong> A Project Manager who reads and respects the codebase, and a Software Engineer who honors commercial deadlines.
        </p>
      </div>
      <a
        href="/about"
        class="shrink-0 inline-flex items-center gap-2 rounded-full border border-[#38BDF8] bg-[#38BDF8]/10 px-5 py-2 text-xs font-bold text-[#38BDF8] transition-all hover:bg-[#38BDF8] hover:text-[#0A0A0F]"
      >
        <span>Read full story</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
