---
import { siteConfig } from "../config/site";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Helper to test active link
const isActive = (href: string) => {
  if (href === "/" && currentPath === "/") return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 w-full px-4 pt-3.5 pb-2 transition-all duration-300 md:px-6">
  <!-- Floating Glass Island Capsule -->
  <div class="mx-auto flex h-16 max-w-[1120px] items-center justify-between rounded-full border border-[#26262F]/90 bg-[#13131A]/85 px-4 sm:px-6 shadow-[0_12px_36px_rgba(0,0,0,0.45)] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.07)] backdrop-blur-xl transition-all duration-300 hover:border-[#3A3A46]">
    
    <!-- Brand / Logo Mark -->
    <a
      href="/"
      class="group flex items-center gap-3 focus-visible:outline-sky-400"
      aria-label={`${siteConfig.name} - Home`}
    >
      <div class="relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-cyan-500/30 bg-[#0c121e] shadow-[0_0_15px_rgba(6,182,212,0.25)] ring-1 ring-cyan-500/20 transition-all duration-300 group-hover:scale-105 group-hover:border-cyan-400 group-hover:shadow-[0_0_22px_rgba(6,182,212,0.5)]">
        <img
          src={siteConfig.logo}
          alt={siteConfig.name}
          width="40"
          height="40"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="font-['Space_Grotesk'] text-sm font-bold tracking-tight text-[#F4F4F5] transition-colors group-hover:text-[#38BDF8]">
            {siteConfig.shortName}
          </span>
          <span class="hidden h-1.5 w-1.5 rounded-full bg-[#38BDF8] sm:inline-block animate-pulse"></span>
        </div>
        <span class="hidden text-[11px] font-medium text-[#A1A1AA] sm:block">
          Technical Project Manager · CSE
        </span>
      </div>
    </a>

    <!-- Desktop Navigation: Pill Island Style -->
    <nav class="hidden items-center gap-2 md:flex" aria-label="Main Navigation">
      <div class="flex items-center gap-1 rounded-full border border-[#26262F]/70 bg-[#0A0A0F]/60 p-1 backdrop-blur-md">
        {
          siteConfig.navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  "relative rounded-full px-4 py-1.5 text-xs font-medium transition-all duration-200",
                  active
                    ? "bg-[#1C1C26] text-[#38BDF8] font-semibold border border-[#3A3A46]/60 shadow-[0_0_12px_rgba(56,189,248,0.2)]"
                    : "text-[#A1A1AA] hover:bg-[#1C1C26]/50 hover:text-[#F4F4F5]"
                ]}
                aria-current={active ? "page" : undefined}
              >
                <span>{link.label}</span>
              </a>
            );
          })
        }
      </div>

      <!-- Divider -->
      <div class="h-4 w-[1px] bg-[#26262F] mx-2"></div>

      <!-- CTA Button: Cyan Outlined Pill with Micro-Interaction -->
      <a
        href="/contact"
        class="group inline-flex items-center gap-1.5 rounded-full border border-[#38BDF8] bg-[#38BDF8]/10 px-4 py-1.5 text-xs font-bold text-[#38BDF8] transition-all duration-200 hover:bg-[#38BDF8] hover:text-[#0A0A0F] hover:shadow-[0_0_24px_rgba(56,189,248,0.4)] hover:scale-105"
      >
        <span>Let's talk</span>
        <svg
          class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#26262F] bg-[#1C1C26]/80 text-[#F4F4F5] transition-all hover:border-[#38BDF8] hover:text-[#38BDF8] md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open main menu"
    >
      <svg id="hamburger-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Collapsible Menu (Floating Card) -->
  <div
    id="mobile-menu"
    class="hidden mx-auto mt-2 max-w-[1120px] rounded-3xl border border-[#26262F] bg-[#13131A]/95 p-5 shadow-2xl backdrop-blur-2xl md:hidden transition-all duration-300"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-3" aria-label="Mobile Navigation">
      <ul class="flex flex-col gap-1.5 text-sm font-medium">
        {
          siteConfig.navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "flex items-center justify-between rounded-2xl px-4 py-3 transition-colors",
                    active
                      ? "bg-[#1C1C26] text-[#38BDF8] font-semibold border border-[#3A3A46]"
                      : "text-[#A1A1AA] hover:bg-[#1C1C26]/60 hover:text-[#F4F4F5]"
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  <span>{link.label}</span>
                  {active && <span class="h-2 w-2 rounded-full bg-[#38BDF8] shadow-[0_0_8px_rgba(56,189,248,0.8)]" />}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-2 pt-3 border-t border-[#26262F]">
        <a
          href="/contact"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-[#38BDF8] px-5 py-3 text-sm font-bold text-[#0A0A0F] shadow-[0_0_20px_rgba(56,189,248,0.3)] transition-all hover:bg-white"
        >
          <span>Let's talk</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggleBtn || !mobileMenu || !hamburgerIcon || !closeIcon) return;

    let isOpen = false;

    function toggleMenu(show?: boolean) {
      isOpen = typeof show === 'boolean' ? show : !isOpen;
      toggleBtn?.setAttribute('aria-expanded', String(isOpen));
      toggleBtn?.setAttribute('aria-label', isOpen ? 'Close main menu' : 'Open main menu');
      mobileMenu?.setAttribute('aria-hidden', String(!isOpen));

      if (isOpen) {
        mobileMenu?.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        mobileMenu?.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    toggleBtn.addEventListener('click', () => toggleMenu());

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleMenu(false);
        toggleBtn.focus();
      }
    });

    // Close when clicking nav links
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  }

  // Initialize on load and on Astro view transition navigations
  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
